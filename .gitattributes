# LF for our own text so Windows, macOS and Linux copies compare equal
* text=auto eol=lf
# byte-exact: v38 material, fixtures and templates are hashed or applied as-is
docs/v38-patches/** -text
tests/fixtures/** -text
src/fstk/templates/** -text
*.png binary
*.gz binary
# The launchers keep the line endings their shell needs (named one by one, so the byte-exact rules above stand)
FromStunToKill.sh      text eol=lf
FromStunToKill.command text eol=lf
tools/launch.sh        text eol=lf
FromStunToKill.cmd     text eol=crlf
tools/launch.ps1       text eol=crlf
*.whl                  binary
