      stage: video_sink
      node_type: SINK
      display_name: Video Sink
      user_label: Video Sink
      x: 2800
      y: 0
      parameters:
        adapt_threshold:
          type: double
          value: 0.1
        chroma_weight:
          type: double
          value: 2
        decoder_type:
          type: string
          value: ntsc3d
        display_aspect_ratio:
          type: string
          value: 4:3
        ffmpeg_format:
